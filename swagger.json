{
  "openapi": "3.0.0",
  "info": {
    "title": "AULATECH API",
    "version": "1.0.0",
    "description": "API para la gestión de equipos audiovisuales y reservas"
  },
  "servers": [
    {
      "url": "http://localhost:4001",
      "description": "Servidor local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "example": "Juan Pérez" },
          "email": { "type": "string", "example": "usuario@test.com" },
          "role": {
            "type": "string",
            "enum": ["estudiante", "tecnico", "administrador"],
            "example": "estudiante"
          }
        }
      },

      "Equipment": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "example": "Cámara Sony A7III" },
          "type": { "type": "string", "example": "video" },
          "serialNumber": { "type": "string", "example": "SN-445ABC" },
          "location": { "type": "string", "example": "Estudio 3" },
          "status": {
            "type": "string",
            "enum": ["disponible", "mantenimiento", "ocupado"],
            "example": "disponible"
          }
        }
      },

      "Reservation": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "equipmentId": { "type": "string", "format": "uuid" },
          "date": { "type": "string", "example": "2025-01-01" },
          "startTime": { "type": "string", "example": "08:00" },
          "endTime": { "type": "string", "example": "10:00" },
          "location": { "type": "string", "example": "Estudio A" },
          "status": {
            "type": "string",
            "enum": ["confirmado", "cancelado"],
            "example": "confirmado"
          }
        }
      },

      "Report": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "equipmentId": { "type": "string", "format": "uuid" },
          "description": { "type": "string", "example": "La cámara no enciende" },
          "photoUrl": { "type": "string", "example": "https://drive.google.com/photo.jpg" },
          "priority": {
            "type": "string",
            "enum": ["baja", "media", "alta"],
            "example": "alta"
          },
          "status": {
            "type": "string",
            "enum": ["pendiente", "en_proceso", "resuelto"],
            "example": "pendiente"
          }
        }
      }
    }
  },

  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Registrar usuario",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "role": {
                    "type": "string",
                    "enum": ["estudiante", "tecnico", "administrador"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuario registrado" },
          "400": { "description": "Datos inválidos" },
          "409": { "description": "Email ya existe" }
        }
      }
    },

    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Iniciar sesión",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login exitoso (token generado)" },
          "401": { "description": "Credenciales inválidas" }
        }
      }
    },

    "/api/equipment": {
      "post": {
        "summary": "Crear equipo (solo administradores)",
        "tags": ["Equipment"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Equipment" }
            }
          }
        },
        "responses": {
          "201": { "description": "Equipo creado" },
          "401": { "description": "No autenticado" },
          "403": { "description": "No autorizado" }
        }
      },
      "get": {
        "summary": "Listar equipos",
        "tags": ["Equipment"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Lista de equipos" }
        }
      }
    },

    "/api/reservations": {
      "post": {
        "summary": "Crear reserva",
        "tags": ["Reservations"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["equipmentId", "date", "startTime", "endTime", "location"],
                "properties": {
                  "equipmentId": { "type": "string" },
                  "date": { "type": "string" },
                  "startTime": { "type": "string" },
                  "endTime": { "type": "string" },
                  "location": { "type": "string" },
                  "allowWaitlist": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Reserva creada" },
          "202": { "description": "Agregado a lista de espera" },
          "409": { "description": "Conflicto de horario" }
        }
      }
    },

    "/api/reservations/my": {
      "get": {
        "summary": "Obtener reservas del usuario autenticado",
        "tags": ["Reservations"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Lista de reservas" }
        }
      }
    },

    "/api/reservations/{id}/cancel": {
      "patch": {
        "summary": "Cancelar reserva",
        "tags": ["Reservations"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Reserva cancelada" },
          "404": { "description": "No encontrada" }
        }
      }
    },

    "/api/reports": {
      "post": {
        "summary": "Crear reporte de daño",
        "tags": ["Reports"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Report" }
            }
          }
        },
        "responses": {
          "201": { "description": "Reporte creado" }
        }
      },
      "get": {
        "summary": "Listar reportes",
        "tags": ["Reports"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["pendiente", "en_proceso", "resuelto"]
            }
          }
        ],
        "responses": {
          "200": { "description": "Lista de reportes" }
        }
      }
    },

    "/api/reports/{id}/status": {
      "patch": {
        "summary": "Actualizar estado de reporte",
        "tags": ["Reports"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["pendiente", "en_proceso", "resuelto"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Estado actualizado" }
        }
      }
    }
  }
}
